# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/collab-editor

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# CORS — the URL the Vite client runs on
CLIENT_URL=http://localhost:5173

# Redis — active room state (code, language, users) with 30-min TTL
REDIS_URL=redis://localhost:6379

# Judge0 (RapidAPI) — get a free key at rapidapi.com → search "Judge0 CE"
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
